                    "lines": [
                        {
                            "spans": [
                                {
                                    "type": "text",
                                    "content": "维护三条核心链表，分别存储记录，商品，客户信息，每条链表各两份数据文件(.txt)，分别作为本次启动的修改目标和启动前的备份。"
                                }
                            ]
                        }
                    ],
