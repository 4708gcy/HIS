flowchart TB
    classDef sys fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#0d47a1
    classDef role fill:#fff8e1,stroke:#f57f17,stroke-width:2px,color:#e65100
    classDef support fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1b5e20
    classDef brace fill:#ffffff,stroke:#888888,stroke-width:1px,color:#222222

    TITLE([HIS 医院信息管理系统]):::sys

    subgraph ENTRY["公共流程"]
        direction LR
        A[启动程序]:::sys --> B[加载 Data/ 中的用户、医疗记录、药品、床位链表]:::sys
        B --> C{是否已有管理员?}:::sys
        C -->|否| D[强制创建管理员]:::sys
        C -->|是| E[登录 / 注册 / 退出]:::sys
        D --> E
        E --> F[身份验证：ID + SHA-256 加盐密码 + 锁定检查]:::sys
        F --> G[进入对应角色菜单]:::sys
        G --> H[退出时保存 12 条链表到 txt 文件]:::sys
    end

    TITLE --> ENTRY
    ENTRY --> ROLES

    subgraph ROLES["五类角色功能（横向大括号汇总）"]
        direction TB
        RA["管理员 {"]
        RAB["账户管理｜医疗记录管理｜药品管理｜床位管理｜账号激活/封锁｜统计报表｜个人信息维护"]
        RAE["}"]

        RB["医生 {"]
        RBB["挂号管理｜创建看诊记录｜填写诊断和处方｜添加检查项目｜设置住院建议｜个人信息维护"]
        RBE["}"]

        RC["护士 {"]
        RCB["住院记录维护｜分配护士和床位｜床位调整｜出院办理｜维护检查结果｜录入生命体征｜个人信息维护"]
        RCE["}"]

        RD["药剂师 {"]
        RDB["处方审核｜创建用药记录｜维护用药明细｜患者缴费后发药｜扣减库存｜药品库存管理｜个人信息维护"]
        RDE["}"]

        RE["患者 {"]
        REB["预约挂号｜缴纳挂号费｜撤回未缴费挂号｜查看看诊/检查/用药/住院信息｜缴费｜账户充值｜个人信息维护"]
        REE["}"]

        RA --> RAB --> RAE
        RB --> RBB --> RBE
        RC --> RCB --> RCE
        RD --> RDB --> RDE
        RE --> REB --> REE
    end

    ROLES --> SUPPORT

    subgraph SUPPORT["底层支撑能力"]
        direction LR
        S1[动态内存双向链表：5 类用户 + 7 类业务记录]:::support
        S2[文本文件持久化：CSV 主记录 + 附加行保存嵌套数据]:::support
        S3[安全机制：SHA-256 加盐哈希、连续失败锁定、恒时比较]:::support
        S4[输入校验：ID、金额、日期、电话、邮箱、科室、床位编号等]:::support
        S5[运行保障：操作日志、异常捕获、信号处理与紧急保存]:::support
    end
